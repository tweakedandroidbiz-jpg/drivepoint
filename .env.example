# Public OSM tile endpoint for development only. Configure a suitable provider for production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional compatible service endpoints.
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org/search
VITE_ROUTING_URL=https://router.project-osrm.org
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

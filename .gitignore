# ============================================================
# DRIVEPOINT .gitignore
# Node.js / TypeScript / React / Capacitor / Android
# ============================================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*

# ---- Build output ----
dist/
dist-ssr/
build/
*.local

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- TypeScript ----
*.tsbuildinfo

# ---- Capacitor ----
# Generated web assets copied into the Android project by `cap sync`
android/app/src/main/assets/public/
# Capacitor CLI local state
.capacitor/

# ---- Android ----
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/*.iml
android/.idea/
android/app/release/
local.properties
.gradle/
gradle-app.setting
.apt_generated
.externalNativeBuild
*.hprof

# ---- Testing / coverage ----
coverage/
.nyc_output/

# ---- Misc ----
.cache/
.parcel-cache/
*.tgz
